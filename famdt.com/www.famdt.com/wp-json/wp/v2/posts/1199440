if.  Jauge maximale : 20 personnes.  De 9h30 \u00e0 12h30","og_url":"https:\/\/www.famdt.com\/actualite-adherent\/stage-de-damien-toumi-sur-la-decouverte-de-la-pratique-de-la-polyphonie-populaire-dans-le-repertoire-occitan-au-festival-voix-partagees\/","og_site_name":"LMELB","article_published_time":"2025-04-14T13:07:47+00:00","author":"cielamparo@gmail.com","twitter_card":"summary_large_image","twitter_misc":{"\u00c9crit par":"cielamparo@gmail.com","Dur\u00e9e de lecture estim\u00e9e":"1 minute"},"schema":{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/www.famdt.com\/actualite-adherent\/stage-de-damien-toumi-sur-la-decouverte-de-la-pratique-de-la-polyphonie-populaire-dans-le-repertoire-occitan-au-festival-voix-partagees\/#article","isPartOf":{"@id":"https:\/\/www.famdt.com\/actualite-adherent\/stage-de-damien-toumi-sur-la-decouverte-de-la-pratique-de-la-polyphonie-populaire-dans-le-repertoire-occitan-au-festival-voix-partagees\/"},"author":{"name":"cielamparo@gmail.com","@id":"https:\/\/www.famdt.com\/#\/schema\/person\/a20fce030af5627246c5cc6cd59986c0"},"headline":"Stage de Damien Toumi sur la d\u00e9couverte de la pratique de la polyphonie populaire dans le r\u00e9pertoire occitan au Festival Voix Partag\u00e9es","datePublished":"2025-04-14T13:07:47+00:00","mainEntityOfPage":{"@id":"https:\/\/www.famdt.com\/actualite-adherent\/stage-de-damien-toumi-sur-la-decouverte-de-la-pratique-de-la-polyphonie-populaire-dans-le-repertoire-occitan-au-festival-voix-partagees\/"},"wordCount":268,"publisher":{"@id":"https:\/\/www.famdt.com\/#organization"},"image":{"@id":"https:\/\/www.famdt.com\/actualite-adherent\/stage-de-damien-toumi-sur-la-decouverte-de-la-pratique-de-la-polyphonie-populaire-dans-le-repertoire-occitan-au-festival-voix-partagees\/#primaryimage"},"thumbnailUrl":"https:\/\/www.famdt.com\/wp-content\/uploads\/2025\/04\/photo-Damien-Toumi-stage.jpg","keywords":["Stage"],"articleSection":["Adh\u00e9rent"],"inLanguage":"fr-FR"},{"@t